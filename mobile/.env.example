# Base URL of the Plainly backend API.
# - iOS simulator: http://localhost:8080 works fine
# - Android emulator: use http://10.0.2.2:8080
# - Physical device (Expo Go): use your computer's LAN IP, e.g. http://192.168.1.23:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Google Sign-In OAuth client IDs (https://console.cloud.google.com/apis/credentials).
# Create one "OAuth client ID" per platform you plan to support and paste each
# one below. Leave blank to hide/disable the "Continue with Google" button's
# functionality (it will show a setup hint instead of signing in).
# Note: Google sign-in requires a custom dev/standalone build — it will not
# complete inside Expo Go.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
