# MongoDB Atlas connection string (must be an Atlas cluster to use $vectorSearch)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=plainly

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Server port
PORT=8080

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173

# Secret used to sign account session tokens (JWTs). Generate a long random
# string, e.g. `openssl rand -base64 48`. Changing it logs everyone out.
JWT_SECRET=change_me_to_a_long_random_string

# Google Sign-In (https://console.cloud.google.com/apis/credentials): create an
# OAuth client ID for each platform you support (Web, iOS, Android) and list all
# of them here, comma-separated — the mobile app sends whichever one it used.
GOOGLE_CLIENT_IDS=

# Sign in with Apple (https://developer.apple.com/account/resources/identifiers/list/serviceId):
# your app's bundle id and/or Services ID(s), comma-separated.
APPLE_CLIENT_IDS=
